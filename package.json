{
  "name": "web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e && npm run test:benchmarks",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:benchmarks": "vitest bench --run --config bench/vitest.bench.config.js"
  },
  "dependencies": {
    "mapbox-gl": "^3.16.0",
    "papaparse": "^5.5.3",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/geojson": "^7946.0.14",
    "@types/mapbox-gl": "^3.4.1",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.1.0",
    "typescript": "^5.7.3",
    "vite": "^7.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.16",
    "vue-tsc": "^2.2.8"
  }
}
